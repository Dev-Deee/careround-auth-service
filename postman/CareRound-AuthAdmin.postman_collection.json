                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json();",
                  "pm.test('Old and new ward, token note', function () {",
                  "    pm.expect(r.userId).to.eql(pm.environment.get('nurseUserId'));",
