# careround-auth-service: copy to .env and fill in real values. .env is gitignored; never commit it.

# Postgres user (root docker-compose: careround-postgres)
DB_USERNAME=postgres

# Postgres password
DB_PASSWORD=change-me

# RSA private key that signs tokens (auth-service only). Never commit the real one
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----|<base64 key body>|-----END PRIVATE KEY-----

# RSA public key used to verify access tokens; same value in every service. PEM on one line, | for newlines
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----|<base64 key body>|-----END PUBLIC KEY-----

# Kafka (root docker-compose: careround-kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# user-service base URL
USER_SERVICE_URL=http://localhost:8082

# super-admin created on first start
SEED_ADMIN_EMAIL=superadmin@example.com

# super-admin phone
SEED_ADMIN_PHONE=+2340000000000

# super-admin password
SEED_ADMIN_PASSWORD=change-me

# base of the activation link in emails; point it at the gateway (default without it: http://localhost:8081/...)
ACTIVATION_BASE_URL=http://localhost:8080/api/v1/auth/activate-account
